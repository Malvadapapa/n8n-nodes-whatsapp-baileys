      "parameters": {
        "method": "POST",
        "url": "http://localhost:3100/send/text",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $('Mensaje Recibido (Webhook)').item.json.body.from, message: '💵 *Cotización del Dólar Blue en Vivo:*\\n\\n🟢 *Compra:* $' + $json.compra + '\\n🔴 *Venta:* $' + $json.venta + '\\n📅 *Fecha:* ' + $json.fechaActualizacion + '\\n\\n_(Fuente: DolarApi.com | Escribe *menu* para más opciones)_' }) }}",
        "options": {}
