      "position": [1180, 300],
      "id": "node-reply-dolar",
      "name": "Opción 2: Enviar Dólar"
    },
    {
      "parameters": {
        "amount": 10,
        "unit": "seconds"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [960, 460],
