        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $('Mensaje Recibido (Webhook)').first().json.body.from, message: '🤖 *Menú Principal de Opciones:*\\n\\n¡Hola ' + ($('Mensaje Recibido (Webhook)').first().json.body.fromName || 'amigo') + '! 👋 Bienvenido.\\n\\nElige una de las siguientes opciones respondiendo con el número:\\n\\n1️⃣ *Saludar* - Te envío un saludo cordial y personalizado.\\n2️⃣ *Dólar Blue* - Consulta la cotización del dólar en vivo.\\n3️⃣ *Eco con Retardo (10s)* - Prueba de temporizador con n8n.\\n4️⃣ *Lista de Tareas (TODO)* - Gestor de tareas 100% interactivo.\\n\\n👉 _Escribe el número *1*, *2*, *3* o *4* para continuar._' }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 780],
      "id": "node-reply-menu-default",
      "name": "Fallback: Enviar Menú"
    }
