    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3100/send/text",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $('Mensaje Recibido (Webhook)').first().json.body.from, message: '🤖 ¡Hola ' + ($('Mensaje Recibido (Webhook)').first().json.body.fromName || 'amigo') + ' (' + $('Mensaje Recibido (Webhook)').first().json.body.senderFormatted + ')! 👋\\n\\n¡Espero que estés teniendo un excelente día! ¿En qué más te puedo ayudar hoy? ✨\\n\\n_(Escribe *menu* para volver a ver las opciones)_' }) }}",
