      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3100/send/text",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $('Mensaje Recibido (Webhook)').first().json.body.from, message: '💵 *Cotización del Dólar Blue en Vivo:*\\n\\n🟢 *Compra:* $' + $json.compra + '\\n🔴 *Venta:* $' + $json.venta + '\\n📅 *Actualizado:* ' + $json.fechaActualizacion + '\\n\\n_(Fuente: DolarApi.com | Escribe *menu* para más opciones)_' }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1180, 300],
      "id": "node-reply-dolar",
      "name": "Opción 2: Enviar Dólar"
    },
    {
      "parameters": {
        "amount": 10,
        "unit": "seconds"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [960, 460],
      "id": "node-wait-10s",
      "name": "Esperar 10 Segundos",
      "webhookId": "whatsapp-wait-10s"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3100/send/text",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $('Mensaje Recibido (Webhook)').first().json.body.from, message: '🤖 ⏳ *Eco diferido (10 segundos):*\\n\\n¡Han pasado exactamente 10 segundos desde tu solicitud! Tu temporizador funcionó correctamente. ⏱️🚀\\n\\n_(Escribe *menu* para más opciones)_' }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1180, 460],
      "id": "node-reply-eco-delay",
      "name": "Opción 3: Enviar Eco con Delay"
    },
    {
      "parameters": {
        "jsCode": "const raw = String($json.body.body || '').trim();\nconst phone = $json.body.from;\nlet action = 'list';\nlet taskText = '';\nlet index = null;\n\nconst lower = raw.toLowerCase();\nif (lower.startsWith('4a') || lower.startsWith('4 a')) {\n  action = 'add';\n  taskText = raw.replace(/^4\\s*a\\s*/i, '').trim();\n} else if (lower.startsWith('4b') || lower.startsWith('4 b')) {\n  action = 'complete';\n  const match = raw.match(/^4\\s*b\\s*(\\d+)/i);\n  index = match ? match[1] : null;\n} else if (lower.startsWith('4c') || lower.startsWith('4 c')) {\n  action = 'delete';\n  const match = raw.match(/^4\\s*c\\s*(\\d+)/i);\n  index = match ? match[1] : null;\n} else if (lower.startsWith('4d') || lower.startsWith('4 d')) {\n  action = 'clear';\n}\n\nreturn {\n  json: {\n    phone,\n    action,\n    text: taskText,\n    index\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 620],
      "id": "node-parse-crud",
      "name": "Procesar Comando CRUD"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3100/tasks/action",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ phone: $json.phone, action: $json.action, text: $json.text, index: $json.index }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1180, 620],
      "id": "node-execute-tasks-api",
