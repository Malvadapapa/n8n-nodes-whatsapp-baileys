      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [640, 400],
      "id": "node-switch-menu",
      "name": "Evaluar Opción del Menú"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3100/send/text",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $json.body.from, message: '🤖 ¡Hola ' + ($json.body.fromName || 'amigo') + ' (' + $json.body.senderFormatted + ')! 👋\\n\\n¡Espero que estés teniendo un día increíble! Estoy listo para ayudarte con lo que necesites. 🚀\\n\\n_(Escribe *menu* para volver a ver las opciones)_' }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 160],
      "id": "node-reply-saludo",
      "name": "Opción 1: Saludo"
    },
    {
      "parameters": {
        "url": "https://dolarapi.com/v1/dolares/blue",
        "options": {}
