      "parameters": {
        "method": "POST",
        "url": "http://localhost:3100/send/text",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $json.body.from, message: '📝 *Sistema de Notas / TODO Demo:*\\n\\n✅ [1] Iniciar servidor local de WhatsApp\\n✅ [2] Vincular cuenta con Código QR\\n⏳ [3] Configurar flujos interactivos en n8n (En curso)\\n📌 [4] Integrar Base de Datos / IA generativa (Pendiente)\\n\\n💡 _Tip: Puedes conectar un nodo de Google Sheets, Notion o PostgreSQL para crear un CRUD 100% persistente desde WhatsApp._' }) }}",
