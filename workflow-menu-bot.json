        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $json.phone, message: $json.message }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1400, 620],
      "id": "node-reply-tasks-msg",
