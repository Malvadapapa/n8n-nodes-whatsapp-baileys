{
  "name": "WhatsApp Bot - Eco / Auto Respuesta",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-trigger",
        "responseMode": "onReceived",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "id": "node-webhook-in",
      "name": "Mensaje Recibido (Webhook)",
      "webhookId": "whatsapp-trigger"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-is-self",
              "leftValue": "={{ $json.body.isSelfChat }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            },
            {
              "id": "check-bot-prefix",
              "leftValue": "={{ $json.body.body }}",
              "rightValue": "🤖",
              "operator": {
                "type": "string",
                "operation": "notStartsWith"
              }
            },
            {
              "id": "check-not-empty",
              "leftValue": "={{ $json.body.body }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300],
      "id": "node-if-not-bot",
      "name": "¿Es mi chat privado y tiene texto?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3100/send/text",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $json.body.from, message: '🤖 Eco: ' + ($json.body.body || '') }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 280],
      "id": "node-send-echo",
      "name": "Responder Eco"
    }
  ],
  "connections": {
    "Mensaje Recibido (Webhook)": {
      "main": [
        [
          {
            "node": "¿Es mi chat privado y tiene texto?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Es mi chat privado y tiene texto?": {
      "main": [
        [
          {
            "node": "Responder Eco",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
